# Copy into Vercel → Settings → Environment Variables
# Demo mode auto-enables with these placeholder values (no real DB/API keys needed).

NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true
DATABASE_URL=postgresql://user:password@localhost:5432/vibelaunch
NEXTAUTH_URL=https://YOUR-APP.vercel.app
NEXTAUTH_SECRET=sorano-demo-secret-replace-in-production-32chars
APP_URL=https://YOUR-APP.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
X_CLIENT_ID=test-x-client-id
X_CLIENT_SECRET=test-x-client-secret
OPENAI_API_KEY=sk-test-openai-key-placeholder
QSTASH_TOKEN=test-qstash-token
QSTASH_CURRENT_SIGNING_KEY=test-signing-key-current
QSTASH_NEXT_SIGNING_KEY=test-signing-key-next
# QStash callback URLs are resolved dynamically per-job via getBaseUrl() in src/lib/queue/qstash.ts.
# QSTASH_CALLBACK_URL is only an override/fallback for the post-publish queue (/api/queue/process).
# It is not used for the media capture queue, which always builds `${getBaseUrl()}/api/media/capture/process`.
QSTASH_CALLBACK_URL=https://YOUR-APP.vercel.app/api/queue/process
CRON_SECRET=test-cron-secret
# Auto-populated when Blob storage is enabled on the Vercel project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# Visit /auth/signin → Demo Login (demo / demo) to explore the full dashboard.
