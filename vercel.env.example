# Vercel Environment Variables — copy each into Project Settings → Environment Variables
# Demo mode auto-enables when DATABASE_URL is the placeholder below (no real DB needed).

DEMO_MODE=true
DATABASE_URL=postgresql://user:password@localhost:5432/vibelaunch
NEXTAUTH_URL=https://YOUR-APP.vercel.app
NEXTAUTH_SECRET=vibelaunch-demo-secret-replace-in-production-32chars
APP_URL=https://YOUR-APP.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
X_CLIENT_ID=test-x-client-id
X_CLIENT_SECRET=test-x-client-secret
OPENAI_API_KEY=sk-test-openai-key-placeholder
QSTASH_TOKEN=test-qstash-token
QSTASH_CURRENT_SIGNING_KEY=test-signing-key-current
QSTASH_NEXT_SIGNING_KEY=test-signing-key-next
QSTASH_CALLBACK_URL=https://YOUR-APP.vercel.app/api/queue/process
GOOGLE_SERVICE_ACCOUNT_EMAIL=test-sa@vibelaunch-demo.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nTEST_PLACEHOLDER\n-----END RSA PRIVATE KEY-----
CRON_SECRET=test-cron-secret

# After deploying, replace YOUR-APP with your Vercel domain in NEXTAUTH_URL, APP_URL, etc.
# To use Demo Login: visit /auth/signin and click "Demo Login" (username: demo, password: demo)
