# ─── Demo Mode (no API keys / DB required) ───────────────────────────────────
# Auto-enabled when OPENAI_API_KEY, X_CLIENT_ID, or DATABASE_URL are missing.
# Set NEXT_PUBLIC_DEMO_MODE=true to force demo on the client.
NEXT_PUBLIC_DEMO_MODE="true"
DEMO_MODE="true"

# Database - placeholder keeps demo mode active
DATABASE_URL="postgresql://user:password@localhost:5432/vibelaunch"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sorano-demo-secret-replace-in-production-32chars"

# X (Twitter) - test placeholders (real X sign-in requires valid keys + DEMO_MODE=false)
X_CLIENT_ID="test-x-client-id"
X_CLIENT_SECRET="test-x-client-secret"
X_API_KEY=""

# OpenAI - test placeholder (demo mode uses mock data)
OPENAI_API_KEY="sk-test-openai-key-placeholder"

# Upstash QStash
QSTASH_TOKEN="test-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="test-signing-key-current"
QSTASH_NEXT_SIGNING_KEY="test-signing-key-next"
QSTASH_CALLBACK_URL="http://localhost:3000/api/queue/process"

# Google Indexing API
GOOGLE_SERVICE_ACCOUNT_EMAIL="test-sa@vibelaunch-demo.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nTEST_PLACEHOLDER\n-----END RSA PRIVATE KEY-----"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="test-cron-secret"
