# ─── Preview / Demo Mode ─────────────────────────────────────────────────────
# Auto-enabled when DATABASE_URL is missing or set to the placeholder below.
# Set DEMO_MODE=false to disable even with placeholder DATABASE_URL.
DEMO_MODE="true"

# Database (PostgreSQL with pgvector) — placeholder enables demo mode
DATABASE_URL="postgresql://user:password@localhost:5432/vibelaunch"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="vibelaunch-demo-secret-replace-in-production-32chars"

# X (Twitter) OAuth 2.0 — test placeholders (X sign-in won't work until real keys added)
X_CLIENT_ID="test-x-client-id"
X_CLIENT_SECRET="test-x-client-secret"

# OpenAI (adaptive generator + embeddings) — optional in demo mode
OPENAI_API_KEY="sk-test-openai-key-placeholder"

# Upstash QStash (post queue) — test placeholders
QSTASH_TOKEN="test-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="test-signing-key-current"
QSTASH_NEXT_SIGNING_KEY="test-signing-key-next"
QSTASH_CALLBACK_URL="http://localhost:3000/api/queue/process"

# Google Indexing API — test placeholders
GOOGLE_SERVICE_ACCOUNT_EMAIL="test-sa@vibelaunch-demo.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nTEST_PLACEHOLDER\n-----END RSA PRIVATE KEY-----"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron protection
CRON_SECRET="test-cron-secret"
