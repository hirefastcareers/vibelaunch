# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@localhost:5432/xoopa"

# Explicit demo/stub gate for labeled mock citation-share UI (never invents live metrics)
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# X (Twitter) OAuth 2.0, required for sign-in
# Use Client ID / Client Secret from User authentication settings,
# not the API Key / API Key Secret on the Keys and tokens tab.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# App Bearer Token from the developer portal (Keys and tokens).
# Used for keyword search in Replies. Mentions work with user OAuth alone.
# X_API_KEY is accepted as a fallback alias for the same bearer token.
X_BEARER_TOKEN=""
X_API_KEY=""

# OpenAI — required for generation and embeddings
OPENAI_API_KEY=""

# Upstash QStash
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_CALLBACK_URL="http://localhost:3000/api/queue/process"

# Google Indexing API
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""

# Vercel Blob — auto-populated when Blob storage is enabled on the Vercel project
BLOB_READ_WRITE_TOKEN=""

# Dodo Payments (billing)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/dashboard/billing"
DODO_STARTER_PRODUCT_ID=""
DODO_PRO_PRODUCT_ID=""
