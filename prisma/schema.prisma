generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  xUserId             String?   @unique
  xUsername           String?
  planTier            PlanTier  @default(FREE)
  dodoCustomerId      String?   @unique
  dodoSubscriptionId  String?
  // Mirrors Dodo subscription status strings directly (e.g. "active",
  // "on_hold", "cancelled", "expired", "failed") rather than a closed enum.
  subscriptionStatus  String?
  planRenewsAt        DateTime?
  /// Phase 9 — public AI visibility scorecard (off by default).
  scorecardPublic     Boolean   @default(false)
  scorecardSlug       String?   @unique
  scorecardPublishedAt DateTime?
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  trackedQueries      TrackedQuery[]
  competitorBrands    CompetitorBrand[]
  contentSuggestions  ContentSuggestion[]
  gapAnalyses         CitationGapAnalysis[]
  alerts              Alert[]
  alertPreference     AlertPreference?
  alertPendingChanges AlertPendingChange[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum PlanTier {
  FREE
  STARTER
  PRO
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Phase 1: Projects ─────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String   @unique
  description String?
  tagline     String?
  websiteUrl     String?
  lastCaptureUrl String?
  lastCapturedAt DateTime?
  tone           String?
  keywords    String[] @default([])
  status      ProjectStatus @default(DRAFT)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       Post[]
  analytics   EriSnapshot[]
  changelog   ChangelogEntry[]
  geoMetrics  GeoMetric[]
  testRuns    TestRun[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  LAUNCHED
  ARCHIVED
}

// ─── Phase 2: Posts & Media ──────────────────────────────────────────────────

model Post {
  id            String     @id @default(cuid())
  projectId     String
  content       String
  mediaUrls     String[]   @default([])
  status        PostStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  xPostId       String?
  xPostUrl      String?
  queueJobId    String?
  errorMessage  String?
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  embedding     PostEmbedding?
  analytics     PostAnalytics?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([scheduledAt])
}

enum PostStatus {
  DRAFT
  QUEUED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// ─── Phase 3: Vector reinforcement ─────────────────────────────────────────

model PostEmbedding {
  id        String                       @id @default(cuid())
  postId    String                       @unique
  embedding Unsupported("vector(1536)")?
  eriScore  Float?
  reinforced Boolean                     @default(false)
  post      Post                         @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
}

model PostAnalytics {
  id          String   @id @default(cuid())
  postId      String   @unique
  impressions Int      @default(0)
  likes       Int      @default(0)
  retweets    Int      @default(0)
  replies     Int      @default(0)
  clicks      Int      @default(0)
  eri         Float    @default(0)
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EriSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  avgEri      Float
  topPostId   String?
  postCount   Int      @default(0)
  snapshotAt  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([snapshotAt])
}

// ─── Phase 4: SEO & Changelog ──────────────────────────────────────────────

model ChangelogEntry {
  id          String   @id @default(cuid())
  projectId   String
  slug        String   @unique
  title       String
  summary     String
  body        String   @db.Text
  seoTitle    String?
  seoDesc     String?
  keywords    String[] @default([])
  published   Boolean  @default(false)
  publishedAt DateTime?
  indexedAt   DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([published])
}

// ─── Phase 2 GEO: AI citation tracking (TrackedQuery + CitationRun) ────────

model TrackedQuery {
  id          String              @id @default(cuid())
  userId      String
  brandName   String
  promptText  String
  /// When false, cron / QStash sweeps skip this row.
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         CitationRun[]
  suggestions  ContentSuggestion[]
  gapAnalyses  CitationGapAnalysis[]
  alerts       Alert[]
  pendingAlertChanges AlertPendingChange[]

  @@index([userId])
  @@index([active])
}

enum CitationModel {
  openai
  anthropic
  gemini
  perplexity
  grok
}

enum CitationSentiment {
  positive
  neutral
  negative
}

model CitationRun {
  id             String             @id @default(cuid())
  trackedQueryId String
  model          CitationModel
  runAt          DateTime           @default(now())
  rawResponse    String             @db.Text
  brandMentioned Boolean            @default(false)
  citedUrls      String[]           @default([])
  /// Phase 5 — set only when brandMentioned=true and classifier succeeds; else null.
  sentiment      CitationSentiment?
  /// Set when classify was attempted and failed — stops infinite backfill retries.
  sentimentClassifyFailed Boolean           @default(false)
  /// Non-null when the provider call failed; rawResponse may still hold error context.
  error          String?
  trackedQuery   TrackedQuery       @relation(fields: [trackedQueryId], references: [id], onDelete: Cascade)
  competitorMentions CitationCompetitorMention[]
  suggestionOutcomes SuggestionOutcome[]

  @@index([trackedQueryId])
  @@index([model])
  @@index([runAt])
  @@index([brandMentioned, sentiment])
}

// ─── Phase 4 GEO: competitor brands (user-scoped; detection reuses CitationRun.rawResponse)

model CompetitorBrand {
  id        String   @id @default(cuid())
  userId    String
  brandName String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentions  CitationCompetitorMention[]

  @@unique([userId, brandName])
  @@index([userId])
}

// ─── Phase 5 GEO: competitor mention + sentiment on a citation run ──────────

model CitationCompetitorMention {
  id                String             @id @default(cuid())
  citationRunId     String
  competitorBrandId String
  /// Only written when the competitor was detected in rawResponse.
  mentioned         Boolean            @default(true)
  /// Null when classification failed — never invent a label.
  sentiment         CitationSentiment?
  createdAt         DateTime           @default(now())
  citationRun       CitationRun        @relation(fields: [citationRunId], references: [id], onDelete: Cascade)
  competitorBrand   CompetitorBrand    @relation(fields: [competitorBrandId], references: [id], onDelete: Cascade)

  @@unique([citationRunId, competitorBrandId])
  @@index([competitorBrandId])
  @@index([citationRunId])
  @@index([sentiment])
}

// ─── Phase 6 GEO: citation-gap → content suggestions (“fix it” loop) ─────

enum SuggestionStatus {
  NEW
  DISMISSED
  ACTIONED
}

model ContentSuggestion {
  id                      String            @id @default(cuid())
  userId                  String
  trackedQueryId          String
  model                   CitationModel
  suggestionText          String            @db.Text
  status                  SuggestionStatus  @default(NEW)
  /// Regenerations within the current UTC day window (resets via regenerationWindowStart).
  regenerationCount       Int               @default(0)
  regenerationWindowStart DateTime?
  /// Phase 10 — normalized URL of content the user published for this suggestion.
  publishedUrl            String?
  publishedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedQuery            TrackedQuery      @relation(fields: [trackedQueryId], references: [id], onDelete: Cascade)
  outcomes                SuggestionOutcome[]

  @@index([userId])
  @@index([trackedQueryId])
  @@index([status])
  @@index([userId, trackedQueryId, model])
  @@index([publishedAt])
}

/// Phase 10 — detected citation of a published suggestion URL in a later run.
enum SuggestionMatchType {
  /// Normalized host + path matches a cited URL.
  EXACT
  /// Same host cited, but not the exact published path (weaker signal).
  DOMAIN
}

model SuggestionOutcome {
  id                  String              @id @default(cuid())
  contentSuggestionId String
  citationRunId       String
  matchedAt           DateTime            @default(now())
  model               CitationModel
  matchType           SuggestionMatchType
  contentSuggestion   ContentSuggestion   @relation(fields: [contentSuggestionId], references: [id], onDelete: Cascade)
  citationRun         CitationRun         @relation(fields: [citationRunId], references: [id], onDelete: Cascade)

  @@unique([contentSuggestionId, citationRunId, matchType])
  @@index([contentSuggestionId])
  @@index([citationRunId])
  @@index([matchedAt])
  @@index([matchType])
}

// ─── Phase 11 GEO: why-wasn't-I-cited gap analysis (on-demand, cached) ─────

model CitationGapAnalysis {
  id                 String       @id @default(cuid())
  userId             String
  trackedQueryId     String       @unique
  /// Aggregated dominating domains from missed-run citedUrls.
  topDomains         Json
  /// Fingerprint of top domain set — used to invalidate cache when citations shift.
  domainsFingerprint String
  analysisText       String       @db.Text
  /// Per-URL fetch outcomes (ok / blocked_by_robots / failed) — honesty trail.
  fetchNotes         Json?
  /// LLM generations in the current UTC-month window (shared suggestion quota).
  generationCount       Int       @default(0)
  generationWindowStart DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedQuery       TrackedQuery @relation(fields: [trackedQueryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── Phase 12 GEO: change alerts (2-run confirmed, digest-first) ───────────

enum AlertType {
  CITATION_LOST
  CITATION_GAINED
  COMPETITOR_OVERTAKE
  SENTIMENT_FLIP
}

enum AlertDigestFrequency {
  OFF
  WEEKLY
  IMMEDIATE
}

/// Per-user alert preferences. Defaults favour weekly digest (less noisy).
model AlertPreference {
  id                        String               @id @default(cuid())
  userId                    String               @unique
  citationLostEnabled       Boolean              @default(true)
  citationGainedEnabled     Boolean              @default(true)
  competitorOvertakeEnabled Boolean              @default(true)
  sentimentFlipEnabled      Boolean              @default(true)
  digestFrequency           AlertDigestFrequency @default(WEEKLY)
  /// Optional outbound webhook URL (Starter/Pro). Null = disabled.
  webhookUrl                String?
  webhookFailCount          Int                  @default(0)
  webhookLastError          String?
  webhookLastSuccessAt      DateTime?
  /// Set when consecutive failures trip the circuit (UI shows dead endpoint).
  webhookDisabledAt         DateTime?
  unsubscribeToken          String               @unique @default(cuid())
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Confirmed alerts (after 2 consecutive matching change observations).
model Alert {
  id                    String        @id @default(cuid())
  userId                String
  trackedQueryId        String?
  type                  AlertType
  detail                Json
  createdAt             DateTime      @default(now())
  readAt                DateTime?
  /// When email/webhook delivery succeeded (or digest included it).
  deliveredAt           DateTime?
  /// Email skipped because no mail provider is configured.
  deliverySkippedReason String?
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedQuery          TrackedQuery? @relation(fields: [trackedQueryId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([deliveredAt])
  @@index([type])
}

/// In-flight change candidates awaiting a second confirming run (noise filter).
model AlertPendingChange {
  id               String        @id @default(cuid())
  userId           String
  trackedQueryId   String
  model            CitationModel
  type             AlertType
  /// Stable key e.g. CITATION_LOST:openai or COMPETITOR_OVERTAKE:openai:competitorId
  fingerprint      String
  detail           Json
  consecutiveCount Int           @default(1)
  lastRunId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedQuery     TrackedQuery  @relation(fields: [trackedQueryId], references: [id], onDelete: Cascade)

  @@unique([userId, trackedQueryId, fingerprint])
  @@index([userId])
  @@index([trackedQueryId])
}

// ─── Legacy GEO metrics (archive — no writers; Phase 2 uses CitationRun) ───

/// Historical project-scoped citation checks. Retained so existing rows are not dropped.
/// New writes removed in review-decisions pass; do not use for product features.
model GeoMetric {
  id          String   @id @default(cuid())
  projectId   String
  queryPrompt String
  cited       Boolean  @default(false)
  citationUrl String?
  llmProvider String
  checkedAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([llmProvider])
  @@index([checkedAt])
}

// ─── Phase 7: Autonomous Verification & Diagnostic Agent ───────────────────

model TestRun {
  id         String   @id @default(cuid())
  projectId  String
  suite      String
  status     String
  score      Float
  details    Json
  executedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([suite])
  @@index([executedAt])
}
